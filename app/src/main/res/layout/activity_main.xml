<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/irCoche"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="ir a Coche"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bLista" />

    <Button
        android:id="@+id/irCalculadora"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="Ir a Calculadora"
        app:layout_constraintBottom_toTopOf="@+id/irConversor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/irJuego"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="Ir a Juego"
        app:layout_constraintBottom_toTopOf="@+id/bLista"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/irConversor" />

    <Button
        android:id="@+id/bLista"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="Ver Lista"
        app:layout_constraintBottom_toTopOf="@+id/irCoche"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/irJuego" />

    <Button
        android:id="@+id/irConversor"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="Ir a Conversor Moneda"
        app:layout_constraintBottom_toTopOf="@+id/irJuego"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/irCalculadora" />

</androidx.constraintlayout.widget.ConstraintLayout>